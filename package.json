		"check:fix": "biome check --write .",
		"ci": "pnpm check && pnpm typecheck && pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"turbo": "^2.9.18",
		"typescript": "5.7.3"
	}
}
