{
	"name": "notas-universitarias",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome lint .",
		"format": "biome format --write .",
